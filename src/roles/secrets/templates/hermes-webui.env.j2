OPENROUTER_API_KEY={{ openrouter_api_key }}
HERMES_WEBUI_PASSWORD={{ hermes_webui_password }}
HERMES_DEFAULT_MODEL={{ hermes_default_model | default('qwen/qwen3.6-flash') }}
{# OCI env files require one physical line per variable. The GitHub App
   plugin restores literal backslash-n sequences in the PEM private key. #}
{% for name, value in [
  ('GITHUB_APP_ID', hermes_github_app_id | default('')),
  ('GITHUB_APP_CLIENT_ID', hermes_github_client_id | default('')),
  ('GITHUB_APP_CLIENT_SECRET', hermes_github_client_secret | default('')),
  ('GITHUB_APP_PRIVATE_KEY', hermes_github_private_key | default('')),
  ('GITHUB_APP_INSTALLATION_ID', hermes_github_installation_id | default('')),
] %}
{% if value | string | trim %}
{{ name }}={{ value | string | trim | replace('\r\n', '\n') | replace('\n', '\\n') | replace('\r', '\\n') }}
{% endif %}
{% endfor %}
