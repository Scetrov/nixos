    {
      "id": 15,
      "title": "JVM Process CPU Cores",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 7
      },
      "description": "CPU seconds per second for the game JVM; 1.0 is one fully utilized core.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"project-zomboid\",service=\"project-zomboid\",host=\"habiki\"}[5m])",
